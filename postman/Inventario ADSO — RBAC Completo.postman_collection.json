        {
          "name": "6. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Token renovado', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Nuevo accessToken recibido', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.property('accessToken');",
                  "});",
                  "// Actualizar TOKEN_ADMIN con el nuevo token",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) {",
                  "  pm.collectionVariables.set('TOKEN_ADMIN', body.data.accessToken);",
                  "  console.log('✅ TOKEN_ADMIN actualizado con nuevo token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
