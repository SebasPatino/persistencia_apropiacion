                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN_ADMIN}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
